# Indexability switch only. Canonicals, JSON-LD and sitemap URLs are always
# https://rethymnotours.com — this variable never changes the public origin.
# Leave unset on previews so pages stay noindex.
NEXT_PUBLIC_SITE_URL=

# Resend — without a key, forms open a mailto: draft instead.
RESEND_API_KEY=
# Must match the verified sending domain. After DNS:
# Rethymno Tours desk <desk@rethymnotours.com>
RESEND_FROM=
# Every desk notification and a BCC of the guest confirmation go here.
RESEND_DESK_TO=info@waytocrete.com
# Absolute origin for the logo in emails. Defaults to https://rethymnotours.com.
# Until that domain serves this app, use https://waytocretenextjs.vercel.app
EMAIL_ASSET_ORIGIN=
# Optional Resend dashboard template IDs. Variables: GUEST_NAME, GUEST_MAIL (not EMAIL),
# KIND, LANG, DATE, GUESTS_COUNT, EXPERIENCE, HOTEL, NOTE, PICKUP, DROPOFF, FLIGHT,
# COMPANY, PHONE_LINE, TIME, WEDDING, WHATSAPP_URL, DESK_MAIL, PHONE_DISPLAY.
# Use {{{VAR}}} in the dashboard for unescaped HTML.
RESEND_TEMPLATE_DESK=
RESEND_TEMPLATE_GUEST=

# ── Vercel ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL is the switch that makes a deployment indexable.
# Set it to https://rethymnotours.com on the Production environment ONLY.
# Leave it unset on Preview and Development: robots.txt then serves
# `Disallow: /`, the sitemap and llms.txt return nothing, and every page
# ships `noindex` — which is what stops a preview competing with production.
# The website URL and every canonical still resolve to rethymnotours.com.
